# Runtime configuration for the experimental prototype.
ENVIRONMENT=development

# Optional compatible vision-model endpoint. Images are sent only when the
# caller explicitly selects model assistance in the UI or API.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_VISION=nvidia/cosmos-reason-2

# Reserved for future text-model routing; not used by current inspection.
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_NANO=nvidia/nemotron-3-nano
